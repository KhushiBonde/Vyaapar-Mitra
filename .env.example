# ─── DukaanAI Environment Variables ──────────────────────────────────────────
# Copy this file to '.env' and fill in your values.
# The app will work with default values for local development (no setup needed).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (file: dukaanai.db) for local development.
# For production, use a PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/dukaanai
DATABASE_URL=

# ── AI Provider ───────────────────────────────────────────────────────────────
# Set EITHER OpenAI or Anthropic key (not both required).
# The ai_agent.py module uses these to call the LLM for intent detection.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Which LLM model to use for intent detection and response generation.
# Recommended: gpt-4o (OpenAI) or claude-3-5-sonnet-20241022 (Anthropic)
AI_MODEL=gpt-4o

# ── WhatsApp Provider ─────────────────────────────────────────────────────────
# Options: "mock" (default, no credentials needed), "twilio", "meta"
WHATSAPP_PROVIDER=mock

# -- Twilio (only needed if WHATSAPP_PROVIDER=twilio) ─────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+14155238886

# -- Meta Cloud API (only needed if WHATSAPP_PROVIDER=meta) ───────────────────
META_ACCESS_TOKEN=your_permanent_system_user_token
META_PHONE_NUMBER_ID=your_phone_number_id
# The webhook verification token you set in the Meta developer console:
META_WEBHOOK_VERIFY_TOKEN=dukaanai_verify_token_2024

# ── Auth & Security ───────────────────────────────────────────────────────────
# Secret key for signing JWT tokens. CHANGE THIS in production!
JWT_SECRET_KEY=change_me_in_production_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── App Config ────────────────────────────────────────────────────────────────
# URL of the frontend (for CORS allow-origins)
FRONTEND_URL=http://localhost:5173

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
