# ═══════════════════════════════════════════════════════════════════════════════
# Vyaapar Mitra (DukaanAI) — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# DEPLOYMENT ARCHITECTURE:
#   Frontend (Vercel)  → Only needs VITE_ prefixed variables
#   Backend  (Railway) → Needs all other variables below
#
# Copy this file to the appropriate location and fill in your values:
#   Backend:   cp .env.example backend/.env
#   Frontend:  cp .env.example frontend/.env  (only VITE_ vars are read)
#
# In production, set these in the hosting dashboard:
#   Vercel:   Project Settings → Environment Variables
#   Railway:  Service → Variables
# ═══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
# BACKEND VARIABLES (set in Railway dashboard)
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Cloud PostgreSQL connection string (REQUIRED in production).
# Leave blank for local development (defaults to SQLite: dukaanai.db).
#
# Recommended providers:
#   Neon (free tier):     postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
#   Supabase:             postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#   Vercel Postgres:      postgres://... (auto-converted to postgresql:// internally)
DATABASE_URL=

# ── AI Provider ───────────────────────────────────────────────────────────────
# Set at least ONE key. The AI agent uses these for intent detection & response.
# Leave blank for mock mode (rule-based responses, no API key needed).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which LLM model to use. Examples:
#   OpenAI:    gpt-4o, gpt-4o-mini
#   Anthropic: claude-3-5-sonnet-20241022
AI_MODEL=gpt-4o

# ── WhatsApp Provider ─────────────────────────────────────────────────────────
# Options: "mock" (default, no credentials needed), "twilio", "meta"
WHATSAPP_PROVIDER=mock

# Twilio (only if WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Meta Cloud API (only if WHATSAPP_PROVIDER=meta)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=

# ── Auth & Security ───────────────────────────────────────────────────────────
# Secret for signing JWT tokens. Use a long random string in production!
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_in_production_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── App Config ────────────────────────────────────────────────────────────────
# Frontend URL(s) allowed by CORS. Comma-separated for multiple origins.
# Production example: https://vyaapar-mitra.vercel.app
FRONTEND_URL=http://localhost:5173

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# ══════════════════════════════════════════════════════════════════════════════
# FRONTEND VARIABLES (set in Vercel dashboard)
# ══════════════════════════════════════════════════════════════════════════════

# URL of the deployed backend API.
# Local dev:   http://localhost:8000
# Production:  https://your-backend-service.railway.app
VITE_API_URL=http://localhost:8000
