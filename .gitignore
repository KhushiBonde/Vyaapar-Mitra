# ─── Vyaapar Mitra — .gitignore ───────────────────────────────────────────────

# ── Python / Backend ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── SQLite local DB (never commit!) ───────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
dukaanai.db

# ── Environment variables (never commit!) ─────────────────────────────────────
.env
.env.local
.env.*.local
backend/.env

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/
*.tsbuildinfo

# ── Vite / Build artifacts ────────────────────────────────────────────────────
dist/
dist-ssr/
.vite/

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel/

# ── Miscellaneous ─────────────────────────────────────────────────────────────
*.pem
.yarn/cache
.yarn/unplugged
.pnp.*
