# ─── Vyaapar Mitra Frontend — Environment Variables ──────────────────────────
# Copy this file to '.env' or '.env.local' and fill in your values.
# Variables MUST be prefixed with VITE_ to be available in the browser.
# ─────────────────────────────────────────────────────────────────────────────

# URL of the deployed backend API.
# Local dev:  http://localhost:8000
# Production: https://your-backend.railway.app  (or wherever your FastAPI is hosted)
VITE_API_URL=http://localhost:8000
